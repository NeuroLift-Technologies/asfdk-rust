{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ASFDK Rust Discovery Manifest",
  "type": "object",
  "properties": {
    "name": {"type": "string", "enum": ["Rust"]},
    "description": {"type": "string", "description": "Rust port of the NeuroLift Technologies ASFDK (Solidarity Framework Development Kit)"},
    "version": {"type": "string", "description": "1.0.0"},
    "oroi": {"type": "string", "description": "ORG-DEV-OTOI-1.0.3"},
    "related_repositories": {
      "type": "array",
      "items": {"type": "string", "enum": ["asfdk (Python/TS reference)", "asfdk-go (Go port)", "asfdk-csharp (C#/.NET port)", "asfdk-kotlin", "asfdk-cplus"]}
    },
    "governed_by": {"type": "string", "description": "ORG-DEV-OTOI-1.0.3"},
    "discovery_order": {
      "type": "array",
      "items": {"type": "string", "enum": ["NLT-DEV-OTOI.md", "AGENTS.md", "CLAUDE.md"]}
    }
  },
  "required": ["name", "oroi", "governed_by"]
}
